{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datacontract:import-distribution:lots-import:schema",
  "title": "Ligne de lot d'import fournisseur",
  "description": "Validation technique d'une ligne du flux lots_import, equivalent JSON Schema du contrat ODCS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lot_id",
    "fournisseur_id",
    "sku",
    "quantite_commandee",
    "prix_unitaire_mga",
    "mode_fret",
    "date_commande",
    "date_arrivee_prevue",
    "statut",
    "horodatage_maj"
  ],
  "properties": {
    "lot_id": {
      "type": "string",
      "pattern": "^LOT-20[0-9]{2}-[0-9]{6}$",
      "description": "Identifiant du lot d'import."
    },
    "fournisseur_id": {
      "type": "string",
      "pattern": "^FRN-[0-9]{4}$",
      "description": "Identifiant du fournisseur."
    },
    "sku": {
      "type": "string",
      "pattern": "^(CON|AUD|TEL|MON|LED|ELM)-[0-9]{5}$",
      "description": "Reference produit commandee."
    },
    "quantite_commandee": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "description": "Quantite commandee."
    },
    "prix_unitaire_mga": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 10000000,
      "description": "Prix d'achat unitaire en ariary malgaches (MGA)."
    },
    "mode_fret": {
      "type": "string",
      "enum": ["AIR", "SEA"],
      "description": "Mode d'acheminement : fret aerien ou maritime."
    },
    "date_commande": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date d'emission de la commande."
    },
    "date_arrivee_prevue": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date d'arrivee prevue en depot apres fret et dedouanement."
    },
    "statut": {
      "type": "string",
      "enum": ["commande", "embarque", "en_transit", "dedouane", "receptionne", "annule"],
      "description": "Etat de la ligne de lot dans le cycle d'import."
    },
    "horodatage_maj": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}",
      "description": "Horodatage ISO 8601 de derniere mise a jour."
    }
  }
}
