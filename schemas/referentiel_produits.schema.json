{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datacontract:import-distribution:referentiel-produits:schema",
  "title": "Fiche produit du referentiel electronique",
  "description": "Validation technique d'une ligne du flux referentiel_produits, equivalent JSON Schema du contrat ODCS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sku",
    "nom",
    "famille",
    "prix_achat_mga",
    "prix_vente_mga",
    "fournisseur_id",
    "date_maj"
  ],
  "properties": {
    "sku": {
      "type": "string",
      "pattern": "^(CON|AUD|TEL|MON|LED|ELM)-[0-9]{5}$",
      "description": "Reference produit interne, cle primaire."
    },
    "nom": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "description": "Nom commercial du produit."
    },
    "famille": {
      "type": "string",
      "enum": ["consoles_gaming", "audio", "telephonie_accessoires",
               "montres_connectees", "eclairage_led", "electromenager"],
      "description": "Famille marchandise du catalogue electronique."
    },
    "prix_achat_mga": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 10000000,
      "description": "Prix d'achat fournisseur en ariary malgaches (MGA)."
    },
    "prix_vente_mga": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 20000000,
      "description": "Prix de vente conseille en boutique, en ariary malgaches (MGA)."
    },
    "fournisseur_id": {
      "type": "string",
      "pattern": "^FRN-[0-9]{4}$",
      "description": "Fournisseur principal de la reference."
    },
    "date_maj": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}",
      "description": "Horodatage ISO 8601 de derniere mise a jour."
    }
  }
}
