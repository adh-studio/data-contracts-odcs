{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datacontract:offre-supply:stocks-quotidiens:schema",
  "title": "Ligne de stock quotidien",
  "description": "Validation technique d'une ligne du flux stocks_quotidiens, equivalent JSON Schema du contrat ODCS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date_stock",
    "sku",
    "site_id",
    "type_site",
    "quantite_disponible",
    "quantite_reservee",
    "horodatage_maj"
  ],
  "properties": {
    "date_stock": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date de la photo de stock au format ISO 8601."
    },
    "sku": {
      "type": "string",
      "pattern": "^(CAN|LUM|VAI|TAP|RAN)-[0-9]{5}$",
      "description": "Reference produit interne."
    },
    "site_id": {
      "type": "string",
      "pattern": "^(MAG|ENT)-[0-9]{3}$",
      "description": "Identifiant du site."
    },
    "type_site": {
      "type": "string",
      "enum": ["magasin", "entrepot"],
      "description": "Nature du site de stockage."
    },
    "quantite_disponible": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000,
      "description": "Quantite vendable immediatement."
    },
    "quantite_reservee": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000,
      "description": "Quantite reservee par des commandes clients."
    },
    "horodatage_maj": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}",
      "description": "Horodatage ISO 8601 de calcul de la ligne."
    }
  }
}
