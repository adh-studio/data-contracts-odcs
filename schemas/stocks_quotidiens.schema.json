{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datacontract:import-distribution:stocks-quotidiens:schema",
  "title": "Ligne de stock quotidien par depot",
  "description": "Validation technique d'une ligne du flux stocks_quotidiens, equivalent JSON Schema du contrat ODCS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date_stock",
    "sku",
    "depot_id",
    "type_depot",
    "quantite_disponible",
    "quantite_reservee",
    "horodatage_maj"
  ],
  "properties": {
    "date_stock": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date de la photo de stock au format ISO 8601."
    },
    "sku": {
      "type": "string",
      "pattern": "^(CON|AUD|TEL|MON|LED|ELM)-[0-9]{5}$",
      "description": "Reference produit interne."
    },
    "depot_id": {
      "type": "string",
      "pattern": "^DEP-[0-9]{3}$",
      "description": "Identifiant du depot (Ankorondrano, Analakely, Behoririka, Tamatave)."
    },
    "type_depot": {
      "type": "string",
      "enum": ["central", "boutique", "depot_regional"],
      "description": "Nature du site de stockage."
    },
    "quantite_disponible": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000,
      "description": "Quantite vendable immediatement."
    },
    "quantite_reservee": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000,
      "description": "Quantite reservee par des commandes clients ou des transferts."
    },
    "horodatage_maj": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}",
      "description": "Horodatage ISO 8601 de calcul de la ligne."
    }
  }
}
